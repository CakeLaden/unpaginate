{
  "startUrl": "https://www.audible.com/special-promo/2for1/cat?node=120291920011&pageSize=50&ref=a_special-p_c4_pageSize_3&page=1",
  "itemSelector": "li.bc-list-item[id^=\"product-list-item-\"]",
  "extract": {
    "title": { "selector": "h3.bc-heading", "type": "text" },
    "author": { "selector": ".authorLabel", "type": "text" },
    "narrator": { "selector": ".narratorLabel", "type": "text" },
    "duration": { "selector": ".runtimeLabel", "type": "text" },
    "cover": { "selector": "picture img", "type": "image" },
    "href": {
      "selector": "a[href*=\"/pd/\"]",
      "type": "attr",
      "attr": "href"
    }
  },
  "pagination": {
    "type": "paramIncrement",
    "param": "page",
    "start": 1,
    "step": 1
  },
  "maxPages": 26,
  "dedupeBy": "href"
}
